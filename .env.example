# SyncMate AI Backend Environment Configuration

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Firebase Admin Service Account Key Path (Leave blank to use Application Default Credentials or local dev mode)
FIREBASE_CREDENTIALS_PATH=

# Enable or disable Firebase Token verification for AI endpoints (true/false)
FIREBASE_AUTH_ENABLED=true

# Allowed CORS Origins (comma-separated, no wildcards when allow_credentials=true)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000

# Rate Limiting (e.g. 60/minute, 100/hour)
RATE_LIMIT=60/minute

# Max File Upload Size in Megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10
