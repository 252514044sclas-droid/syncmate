      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.morgan@university.edu\",\n  \"password\": \"student123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/auth/login.php",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["auth", "login.php"]
            }
          }
        },
