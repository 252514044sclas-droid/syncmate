rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection: Public roommate-matching profile & private contact subcollection
    match /users/{userId} {
      // Any authenticated student may read public profiles for roommate matching (no email/phone in this doc)
      allow read: if isAuthenticated();

      // Only the account owner may create or update their public profile
      allow write: if isOwner(userId);

      // Private subcollection: readable and writable ONLY by the document owner
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Roommate Connection Requests Collection
    match /roommate_requests/{requestId} {
      // Only the sender or receiver can read the request
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      // Sender can create a new pending request
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid &&
        request.resource.data.status == 'PENDING';

      // Updates:
      // - Only the receiver can change status to ACCEPTED or DECLINED
      // - Only the sender can cancel
      allow update: if isAuthenticated() && (
        (
          resource.data.receiverId == request.auth.uid &&
          request.resource.data.status in ['ACCEPTED', 'DECLINED']
        ) ||
        (
          resource.data.senderId == request.auth.uid &&
          request.resource.data.status == 'CANCELLED'
        )
      );

      // Only the sender can delete their own request
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // 3. Direct 1-on-1 Chat Channels Collection
    match /chats/{chatId} {
      // Read/write only if auth.uid is in participants
      allow read: if isAuthenticated() &&
        resource.data.participants.hasAny([request.auth.uid]);

      allow create: if isAuthenticated() &&
        request.resource.data.participants.hasAny([request.auth.uid]) &&
        request.resource.data.participants.size() == 2;

      allow update: if isAuthenticated() &&
        resource.data.participants.hasAny([request.auth.uid]) &&
        request.resource.data.participants.hasAny([request.auth.uid]);

      allow delete: if false;

      // Real-time messages subcollection
      match /messages/{messageId} {
        // Read only if auth.uid is in the parent chat's participants
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);

        // Create message:
        // - auth.uid is in parent chat's participants
        // - senderId == auth.uid
        // - text is a non-empty string under 2000 characters
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }
  }
}
